<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <!-- Заголовок и кнопка назад -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/back_button_description"
            android:src="@drawable/back"
            app:tint="?attr/colorOnSurface"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="@string/search"
            style="@style/TextAppearance.SettingsTitle" />
    </LinearLayout>


    <!-- Поисковое поле -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:background="@drawable/rounded_search_field_background"
        android:layout_marginBottom="16dp">

        <LinearLayout
        android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/search_icon__1_"
                android:contentDescription="@string/search_icon_description"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="9dp"
                app:tint="@color/search_bar_icon_and_hint_color" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColor="#000000"
                android:textColorHint="@color/search_bar_icon_and_hint_color"
                android:imeOptions="actionDone"
                android:inputType="text|textCapSentences"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textSize="16sp"
                android:fontFamily="@font/ys_display_regular"
                android:lineSpacingMultiplier="1.0"
                android:letterSpacing="0.0"
                android:paddingVertical="12dp"
                android:layout_marginEnd="8dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/clearSearchButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="@string/clear_search_description"
            android:src="@drawable/ic_clear_24"
            android:visibility="gone"
            android:padding="12dp"
            app:tint="@color/search_bar_icon_and_hint_color" />

    </FrameLayout>

    <!-- Подсказка -->
    <TextView
        android:id="@+id/searchHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textAlignment="center"
        android:textColor="?attr/colorOnSurface"
        android:text="@string/search_hint_message"
        android:visibility="gone" />

    <!-- История поиска -->
    <LinearLayout
        android:id="@+id/historySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/you_searched"
            android:gravity="center"
            style="@style/TextAppearance.SettingsTitle"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="true" />
        <ImageButton
            android:id="@+id/clearHistoryButton"
            android:layout_width="148dp"
            android:layout_height="36dp"
            android:background="@drawable/button__2_"
            android:contentDescription="@string/clear_history_description"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Результаты поиска -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchResultsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp" />

    <!-- Заглушка: нет результатов -->
    <LinearLayout
        android:id="@+id/emptyResultLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/no"
            android:contentDescription="@string/empty_result_description"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_result_message"
            style="@style/TextAppearance.ErrorTitle" />

    </LinearLayout>

    <!-- Заглушка: ошибка -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/disconect"
            android:contentDescription="@string/error_description"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_title"
            style="@style/TextAppearance.ErrorTitle"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_message"
            style="@style/TextAppearance.ErrorTitle"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry_button"
            android:backgroundTint="#1A1B22"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            app:cornerRadius="54dp" />

    </LinearLayout>

        </LinearLayout>
